# Configurações do Banco de Dados PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432

# URL de Conexão do Prisma para o Backend
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db?schema=public"

# Configurações do Backend NestJS
PORT=3000
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=1d

# URL da API para o Frontend Angular
API_URL=http://localhost:3000/api
